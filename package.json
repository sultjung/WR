{
  "name": "iraq-weekly-report",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Arabic-source intelligence and weekly reporting support for the Bismayah project",
  "scripts": {
    "validate:config": "node scripts/validate-config.mjs",
    "validate:cards": "node scripts/validate-article-cards.mjs",
    "validate:data": "node scripts/validate-collected-data.mjs && npm run validate:cards",
    "validate": "npm run validate:config && npm run validate:data",
    "test:gate": "node scripts/test-strict-category-gate.mjs",
    "test:direct-iraq-routing": "node scripts/test-direct-iraq-category-routing.mjs",
    "test:priority-source-discovery": "node scripts/test-priority-source-discovery.mjs",
    "test:recovered-url-sanitizer": "node scripts/test-recovered-url-sanitizer.mjs",
    "test:events": "node scripts/test-group-duplicate-events.mjs",
    "test:foreign-local-audit": "node scripts/test-foreign-local-audit.mjs",
    "test:iraq-scope": "node scripts/test-enforce-iraq-scope.mjs",
    "test:cards": "node scripts/test-article-card-pipeline.mjs",
    "test:cards-merge": "node scripts/test-article-card-merge.mjs",
    "test:importance-category": "node scripts/test-category-importance-scoring.mjs",
    "test:translation-terms": "node scripts/test-preferred-translation-terms.mjs",
    "test:report-cluster-references": "node scripts/test-report-cluster-reference-normalizer.mjs",
    "test": "npm run test:gate && npm run test:direct-iraq-routing && npm run test:priority-source-discovery && npm run test:recovered-url-sanitizer && npm run test:events && npm run test:foreign-local-audit && npm run test:iraq-scope && npm run test:cards && npm run test:cards-merge && npm run test:importance-category && npm run test:translation-terms && npm run test:report-cluster-references",
    "audit:foreign-local": "node scripts/audit-foreign-local-leakage.mjs",
    "collect:discover": "node scripts/collect-arabic-news.mjs",
    "collect:recover": "node scripts/recover-source-urls.mjs && node scripts/sanitize-recovered-article-urls.mjs",
    "collect:priority-discovery": "node scripts/discover-priority-source-news.mjs && node scripts/sanitize-recovered-article-urls.mjs",
    "collect:resolve": "node scripts/resolve-article-urls.mjs",
    "collect:priority-aggregator-fallback": "node scripts/restore-priority-aggregator-urls.mjs",
    "collect:incremental-prepare": "node scripts/prepare-incremental-collection.mjs",
    "collect:content": "node scripts/run-fetch-arabic-content.mjs",
    "collect:title-fix": "node scripts/fix-generic-article-titles.mjs",
    "collect:incremental-preserve": "node scripts/preserve-processed-articles.mjs",
    "collect:iraq-scope": "node scripts/enforce-iraq-scope.mjs",
    "collect:strict-gate": "node scripts/strict-category-gate.mjs",
    "collect:direct-iraq-routing": "node scripts/reclassify-direct-iraq-international.mjs",
    "collect:events": "node scripts/group-duplicate-events.mjs",
    "collect:importance-prepare": "node scripts/prepare-importance-scoring.mjs",
    "collect:importance": "node scripts/score-article-importance.mjs",
    "collect:importance-business": "node scripts/apply-business-importance-floor.mjs",
    "collect:cards": "node scripts/generate-article-cards.mjs",
    "collect:related-titles": "node scripts/generate-related-titles.mjs",
    "collect:cards-merge": "node scripts/merge-generated-article-cards.mjs",
    "collect": "npm run validate:config && npm run collect:discover && npm run collect:recover && npm run collect:priority-discovery && npm run collect:resolve && npm run collect:priority-aggregator-fallback && npm run collect:incremental-prepare && npm run collect:content && npm run collect:title-fix && npm run collect:incremental-preserve && npm run collect:iraq-scope && npm run collect:strict-gate && npm run collect:direct-iraq-routing && npm run collect:events && npm run collect:importance-prepare && npm run collect:importance && npm run collect:importance-business && npm run collect:cards && npm run collect:related-titles && npm run audit:foreign-local && npm run validate:data",
    "report:prepare": "node scripts/prepare-report-request.mjs",
    "report:category-routing": "node scripts/normalize-report-category-routing.mjs",
    "report:oil": "python scripts/fetch-opinet-crude.py",
    "report:ai": "node scripts/run-weekly-report-generator.mjs",
    "report:docx": "python scripts/render-weekly-report.py",
    "report:validate": "python scripts/validate-weekly-report.py",
    "report:template": "python scripts/build-weekly-report-template.py"
  },
  "engines": {
    "node": ">=22"
  }
}
